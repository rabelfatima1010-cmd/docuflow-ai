# Copy to backend/.env and fill in.

# --- Extraction ---
# claude = Anthropic Claude (needs ANTHROPIC_API_KEY)
# openai = OpenAI GPT (needs OPENAI_API_KEY)
# mock   = offline demo using samples/ground_truth (free, no key)
EXTRACTOR=mock

# Claude settings
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (higher = more careful, slower, more tokens)
LLM_EFFORT=medium
LLM_FALLBACKS=true

# OpenAI settings
OPENAI_API_KEY=
# gpt-6-astra (best) | gpt-6.1-sol (balanced) | gpt-6.1-terra (fast) | gpt-6-luna (cheapest)
OPENAI_MODEL=gpt-6.1-sol
# Optional: none | minimal | low | medium | high | xhigh | max  (leave commented for the model default)
# OPENAI_REASONING_EFFORT=low
MAX_CORRECTION_ATTEMPTS=2
AUTO_APPROVE_THRESHOLD=0.90
USE_PDF_TEXT_MODE=true

# --- Storage --- (defaults: SQLite + local files under backend/data)
# DATABASE_URL=postgresql+psycopg://docuflow:docuflow@localhost:5432/docuflow
# STORAGE_DIR=./data/uploads

# --- Queue --- (empty = process in a background thread; set to use Redis + `python -m app.worker`)
REDIS_URL=

# --- API ---
CORS_ORIGINS=http://localhost:3000
# Shared secret n8n sends in the X-Webhook-Secret header
WEBHOOK_SECRET=change-me

# --- Exports (all optional) ---
EXPORT_ON_APPROVE=true
# Google Sheets via a service account: share the sheet with the service account's email
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SHEET_ID=
GOOGLE_WORKSHEET=Invoices
# POST each approved invoice as JSON to n8n (e.g. the export-to-sheets workflow, or a QuickBooks/Xero flow)
N8N_EXPORT_WEBHOOK_URL=

# --- Public hosting safeguards (see README "Share it online") ---
# When set, uploads and review actions need this code; browsing stays open
UPLOAD_ACCESS_CODE=
# AI runs per day for the whole site / per visitor IP (0 = unlimited)
DAILY_UPLOAD_LIMIT=40
PER_IP_DAILY_LIMIT=10
MAX_PDF_PAGES=5
# Load the 20 sample invoices from a real AI run into an empty database on start
SEED_DEMO=true
